---
interface Props {
  title: string;
  summary: string;
  date: Date;
  tags: string[];
  href: string;
}
const { title, summary, date, tags, href } = Astro.props;
const dateStr = date.toISOString().slice(0, 10);
---
<li class="post-item">
  <time>{dateStr}</time>
  &nbsp;
  <a href={href} class="title">{title}</a>
  <p class="summary">{summary}</p>
  {tags.length > 0 && <p class="tags">{tags.join(' / ')}</p>}
</li>

<style>
  .post-item { padding: 0.6rem 0; border-bottom: 1px dashed var(--border); list-style: none; }
  .post-item time { color: var(--text-mute); font-family: var(--font-mono); font-size: 0.9em; }
  .post-item .title { font-size: 1.05rem; font-weight: 500; }
  .post-item .summary { color: var(--text-dim); font-size: 0.9rem; margin: 0.3rem 0 0.2rem 0; }
  .post-item .tags { color: var(--text-mute); font-size: 0.85rem; margin: 0; }
</style>
