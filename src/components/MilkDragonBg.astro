---
// 奶龙全局底层背景。用户需将图片放到 public/milk-dragon.png
// 缺失时自动隐藏
---
<div class="milk-dragon-bg" aria-hidden="true">
  <img src="/milk-dragon.png" alt="" onerror="this.style.display='none'" />
</div>

<style>
  .milk-dragon-bg {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    opacity: 0.12;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  .milk-dragon-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    user-select: none;
  }
</style>
