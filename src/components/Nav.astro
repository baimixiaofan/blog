---
const path = Astro.url.pathname;
const links = [
  { href: '/', label: '首页' },
  { href: '/about', label: '关于' },
  { href: '/projects', label: '项目' },
  { href: '/blog', label: '博客' },
  { href: '/links', label: '友链' },
];
---
<nav class="site-nav">
  <ul>
    {links.map(l => (
      <li><a href={l.href} class:list={['site-nav-item', { selected: path === l.href || (l.href !== '/' && path.startsWith(l.href)) }]}>{l.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .site-nav ul { display: flex; gap: 0; list-style: none; padding: 0; margin: 0; flex-wrap: wrap; }
  .site-nav-item {
    display: inline-block;
    padding: 6px 10px 15px;
    margin-left: 1.25rem;
    font-size: 1rem;
    color: var(--text-dim);
  }
  .site-nav-item:first-child { margin-left: 0; }
  .site-nav-item:hover { color: var(--text); text-decoration: none; }
  .site-nav-item.selected {
    color: var(--text);
    padding: 6px 10px 13px;
    border-bottom: 2px solid var(--accent);
  }
</style>
