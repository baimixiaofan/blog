---
interface Props {
  title: string;
  summary: string;
  date: Date;
  url: string;
}
const { title, summary, date, url } = Astro.props;
const dateStr = date.toISOString().slice(0, 10);
const isExternal = url.startsWith('http');
---
<li class="post-item">
  <time>{dateStr}</time>
  &nbsp;
  <a href={url} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener' : undefined} class="title">{title} {isExternal && <span class="ext">↗</span>}</a>
  <p class="summary">{summary}</p>
</li>

<style>
  .post-item { padding: 0.6rem 0; border-bottom: 1px dashed var(--border); list-style: none; }
  .post-item time { color: var(--text-mute); font-family: var(--font-mono); font-size: 0.9em; }
  .post-item .title { font-size: 1.05rem; font-weight: 500; }
  .post-item .ext { color: var(--text-mute); font-size: 0.85em; }
  .post-item .summary { color: var(--text-dim); font-size: 0.9rem; margin: 0.3rem 0 0; }
</style>
