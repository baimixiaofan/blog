---
import Layout from '../components/Layout.astro';
---
<Layout title="404 - 白米饭的个人博客">
  <div class="container not-found">
    <h1>404</h1>
    <p>页面不存在</p>
    <p><a href="/">返回首页</a></p>
  </div>
</Layout>

<style>
  .not-found { text-align: center; padding: 5rem 1.5rem; }
  .not-found h1 { font-size: 5rem; color: var(--accent); border: none; padding: 0; }
</style>
