---
import Layout from '../components/Layout.astro';
import Avatar from '../components/Avatar.astro';
import { readFile } from 'node:fs/promises';

const raw = await readFile('src/content/about/about.md', 'utf-8');
const body = raw.replace(/^---[\s\S]*?---\n/, '');

function renderMd(md: string): string {
  return md
    .replace(/^# (.+)$/gm, '<h1>$1</h1>')
    .replace(/^## (.+)$/gm, '<h2>$1</h2>')
    .replace(/^### (.+)$/gm, '<h3>$1</h3>')
    .replace(/^- (.+)$/gm, '<li>$1</li>')
    .replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>')
    .replace(/\n\n/g, '</p><p>')
    .replace(/^(?!<[hu])/gm, '<p>');
}
---
<Layout title="关于 - 范升耀">
  <div class="container about-page">
    <div class="profile">
      <Avatar name="范升耀" size={88} />
      <div>
        <p class="meta">重庆大学 · 国家卓越工程师学院 · 明月科创实验班 2025 级</p>
        <p class="meta">GitHub: <a href="https://github.com/baimixiaofan" target="_blank" rel="noopener">@baimixiaofan</a></p>
      </div>
    </div>
    <article set:html={renderMd(body)} />
  </div>
</Layout>

<style>
  .about-page { padding: 1rem 0 2rem; }
  .profile { display: flex; align-items: center; gap: 1rem; padding: 0.5rem 0 1.5rem; border-bottom: 1px solid var(--border); margin-bottom: 1.5rem; }
  .meta { color: var(--text-dim); font-size: 0.9rem; margin: 0.15rem 0; }
</style>
