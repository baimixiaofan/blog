---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// 按知识库分组;组间按该库最新文章日期倒序(posts 已全局倒序),"其他"(本地文章)固定排最后
const grouped = new Map<string, { name: string; posts: typeof posts }>();
for (const p of posts) {
  const slug = p.data.spaceSlug || 'other';
  if (!grouped.has(slug)) grouped.set(slug, { name: p.data.space || '其他', posts: [] });
  grouped.get(slug)!.posts.push(p);
}
const spaces = [...grouped.entries()].map(([slug, g]) => ({ slug, ...g }));
const otherIdx = spaces.findIndex(s => s.slug === 'other');
if (otherIdx > -1) spaces.push(...spaces.splice(otherIdx, 1));
---
<Layout title="博客 - 范升耀" description="文章列表 (内容托管于飞书云文档)">
  <div class="container">
    <h1>博客</h1>
    <p class="intro">文章托管在飞书云文档,按知识库组织。</p>
    {spaces.length === 0 ? (
      <p class="empty">还没有文章。敬请期待。</p>
    ) : (
      <div class="space-list">
        {spaces.map(s => (
          <a href={`/blog/${s.slug}/`} class="space-card">
            <div class="space-info">
              <h2>{s.name}</h2>
              <p>{s.posts.length} 篇文章 · 最近更新 {s.posts[0].data.date.toISOString().slice(0, 10)}</p>
            </div>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>

<style>
  .intro { color: var(--text-dim); margin-bottom: 1.5rem; }
  .empty { color: var(--text-dim); padding: 3rem 0; text-align: center; }
  .space-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .space-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
    color: var(--text);
    padding: 1rem 1.25rem;
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }
  .space-card:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 12px rgba(210, 105, 17, 0.08);
    text-decoration: none;
    transform: translateY(-1px);
  }
  .space-info { flex: 1; min-width: 0; }
  .space-info h2 {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 0.2rem;
  }
  .space-info p {
    color: var(--text-mute);
    font-size: 0.85rem;
    margin: 0;
  }
  .arrow { color: var(--text-mute); font-size: 1.1rem; }
  .space-card:hover .arrow { color: var(--accent); }
</style>
