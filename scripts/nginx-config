server {
    listen 80;
    server_name baimeixiaofan.xyz www.baimeixiaofan.xyz;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name baimeixiaofan.xyz www.baimeixiaofan.xyz;
    root /var/www/baimeixiaofan;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/baimeixiaofan.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/baimeixiaofan.xyz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    location / { try_files $uri $uri/ =404; }
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff2?)$ { expires 7d; add_header Cache-Control "public, max-age=604800, immutable"; }
}
